<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Products</h1>
    <% if user_signed_in? && current_user.admin? %>
      <%= link_to "New Product", new_product_path, class: "btn btn-outline-primary" %>
    <% end %>
  </div>

  <% if @products.empty? %>
    <p>No cards for sale yet. Check back soon!</p>
  <% end %>

  <div class="row">
    <% @products.each do |product| %>
      <div class="col-md-4 mb-4">
        <div class="card h-100">
          <div class="card-body d-flex flex-column">
            <h5 class="card-title"><%= link_to product.name, product %></h5>
            <p class="card-text fw-bold"><%= product.price_cents.format %></p>

            <div class="mt-auto d-grid gap-2">
              <%= button_to "Add to cart", add_to_cart_product_path(product), method: :post, class: "btn btn-primary" %>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>
