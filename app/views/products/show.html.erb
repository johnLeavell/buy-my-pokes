<div class="container mt-4">
  <h1><%= @product.name %></h1>

  <p class="fs-4 fw-bold"><%= @product.price_cents.format %></p>

  <%= button_to "Add to cart", add_to_cart_product_path(@product), method: :post, class: "btn btn-primary" %>

  <% if user_signed_in? && current_user.admin? %>
    <div class="mt-3">
      <%= link_to "Edit", edit_product_path(@product), class: "btn btn-outline-secondary" %>
      <%= button_to "Delete", product_path(@product), method: :delete, class: "btn btn-outline-danger", form: { data: { turbo_confirm: "Are you sure?" } } %>
    </div>
  <% end %>

  <p class="mt-3"><%= link_to "Back to products", products_path %></p>
</div>
