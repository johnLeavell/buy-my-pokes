<!-- Hero 1 - HCF Bootstrap 5 Component -->
<section class="hero-section">
  <div class="container">
    <div class="row justify-content-md-center">
      <div class="col-12 col-md-11 col-lg-9 col-xl-7 col-xxl-6 text-center text-white">
        <h1 class="display-3 fw-bold mb-3 text-warning">Poke CardKetchum</h1>
        <p class="lead">Buy authentic Pokémon cards from a trusted collector.</p>

        <div class="d-grid gap-2 d-sm-flex justify-content-sm-center mt-4">
          <%= link_to "Browse cards", products_path, class: "btn btn-warning btn-lg px-4" %>
          <%= link_to "Sign up", new_user_registration_path, class: "btn btn-outline-light btn-lg px-4" %>
        </div>
        </div>

      </div>
    </div>
  </div>
</section>
