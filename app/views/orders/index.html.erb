<div class="container mt-4">
  <h1>Your Orders</h1>

  <% if @orders.empty? %>
    <p>You haven't placed any orders yet.</p>
  <% else %>
    <table class="table">
      <thead>
        <tr>
          <th>Date</th>
          <th>Status</th>
          <th>Total</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @orders.each do |order| %>
          <tr>
            <td><%= order.created_at.strftime("%b %d, %Y") %></td>
            <td><%= order.status.titleize %></td>
            <td><%= order.total.format %></td>
            <td><%= link_to "View", order_path(order) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</div>
